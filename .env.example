# ---------------------------------------------------------------------------
# LabCount - variables de entorno
# Copie este archivo como .env y ajuste los valores necesarios.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-segura-y-unica
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos (PostgreSQL obligatorio en la guia)
DB_ENGINE=postgresql
DB_NAME=conteo_lab
DB_USER=conteo_user
DB_PASSWORD=conteo_pass
DB_HOST=127.0.0.1
DB_PORT=5432

# Motores de video (OpenCV)
# Valores permitidos: dnn (recomendado), hybrid, hog, motion
LABCOUNT_DEFAULT_DETECTOR=dnn
LABCOUNT_DNN_CONFIDENCE=0.45
LABCOUNT_CAMERA_INDEX=0
LABCOUNT_MAX_FRAME_WIDTH=960
LABCOUNT_STREAM_FPS=16
LABCOUNT_DETECT_EVERY=2
LABCOUNT_SAMPLE_SECONDS=5
LABCOUNT_LINE_ORIENTATION=vertical
LABCOUNT_LINE_POSITION=0.50
